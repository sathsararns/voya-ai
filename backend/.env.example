# Copy to backend/.env and fill in your own values. Never commit backend/.env.
# Keep values unquoted: Docker Compose reads this file in raw mode.
GROQ_API_KEY=replace-with-your-groq-key
PINECONE_API_KEY=replace-with-your-pinecone-key
PINECONE_INDEX_HOST=https://replace-with-your-index-host
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Used when running Python directly; Docker Compose overrides these URLs.
DATABASE_URL=postgresql+psycopg2://postgres:your-password@localhost:5432/voya
REDIS_URL=redis://localhost:6379/0
FRONTEND_ORIGIN=http://localhost:5173
APP_ENV=development

# Optional: password-reset emails.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
